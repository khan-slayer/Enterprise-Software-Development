{
  "openapi": "3.1.0",
  "info": {
    "title": "Bookstore HTTP API",
    "description": "Enterprise Software Development Assignment 2 - Resilient RESTful HTTP API with Idempotency, Rate Limiting, and Observability.",
    "version": "2.1.0"
  },
  "paths": {
    "/metrics": {
      "get": {
        "summary": "Metrics",
        "description": "Endpoint that serves Prometheus metrics.",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health Check",
        "description": "Liveness probe verifying service and database availability.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/books": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "List all books",
        "description": "Retrieves all books currently in the bookstore catalog. Employs caching headers for REST compliance.",
        "operationId": "get_books_books_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Book"
                  },
                  "title": "Response Get Books Books Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Books"
        ],
        "summary": "Create a new book with Idempotency and Rate Limiting",
        "operationId": "create_book_books_post",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Unique client key for safe request retries",
              "title": "Idempotency-Key"
            },
            "description": "Unique client key for safe request retries"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Book successfully created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "400": {
            "description": "Invalid business data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RFC7807Problem"
                }
              }
            }
          },
          "409": {
            "description": "Duplicate book already exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RFC7807Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation error (e.g. negative price).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RFC7807Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RFC7807Problem"
                }
              }
            }
          }
        }
      }
    },
    "/books/{book_id}": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Get a book by ID",
        "operationId": "get_book_books__book_id__get",
        "parameters": [
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Book Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Book found and returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "404": {
            "description": "Book not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RFC7807Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/experiments/toggle-delay": {
      "post": {
        "tags": [
          "System"
        ],
        "summary": "Toggle Delay",
        "operationId": "toggle_delay_experiments_toggle_delay_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/experiments/cardinality": {
      "post": {
        "tags": [
          "System"
        ],
        "summary": "Trigger Cardinality",
        "operationId": "trigger_cardinality_experiments_cardinality_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Book": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "Unique book identifier"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "author": {
            "type": "string",
            "title": "Author"
          },
          "price": {
            "type": "number",
            "title": "Price"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "author",
          "price"
        ],
        "title": "Book"
      },
      "BookCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "description": "Title of the book"
          },
          "author": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Author",
            "description": "Author's full name"
          },
          "price": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Price",
            "description": "Retail price in USD, strictly positive"
          }
        },
        "type": "object",
        "required": [
          "title",
          "author",
          "price"
        ],
        "title": "BookCreate",
        "example": {
          "author": "Robert C. Martin",
          "price": 29.99,
          "title": "Clean Architecture"
        }
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RFC7807Problem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "description": "URI reference identifying the problem type"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Short, human-readable summary of problem"
          },
          "status": {
            "type": "integer",
            "title": "Status",
            "description": "HTTP status code"
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Human-readable explanation specific to this occurrence"
          },
          "instance": {
            "type": "string",
            "title": "Instance",
            "description": "URI reference identifying the specific occurrence"
          }
        },
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance"
        ],
        "title": "RFC7807Problem"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "tags": [
    {
      "name": "Books",
      "description": "Operations on book resources and catalog inventory."
    },
    {
      "name": "System",
      "description": "Health checks, diagnostics, and experiment controls."
    }
  ]
}