  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate per Replica (req/s) [1m window]",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (replica) (rate(http_server_requests_total[1m]))",
          "legendFormat": "Replica {{replica}} (req/s)"
        }
      ]
    },
    {
      "id": 2,
      "title": "gRPC Request Rate per Replica (req/s) [1m window]",
